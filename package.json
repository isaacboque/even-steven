{
  "name": "even-steven",
  "version": "0.1.0",
  "description": "Snap a receipt, split each item fairly, and send PayPal sandbox requests with the fewest payments needed. Nothing moves without approval.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build web",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "smoke:sandbox": "tsx scripts/smoke-sandbox.ts",
    "eval": "tsx scripts/eval.ts",
    "dev": "concurrently -n api,web \"tsx watch src/index.ts\" \"vite web\""
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^20.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.7",
    "jsdom": "^25.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.102",
    "@ai-sdk/google": "^4.0.117",
    "@ai-sdk/openai": "^4.0.114",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@hono/node-server": "^2.1.6",
    "@paypal/agent-toolkit": "^1.11.0",
    "ai": "^7.0.169",
    "dotenv": "^18.0.10",
    "hono": "^4.13.17",
    "zod": "^4.6.7"
  }
}
