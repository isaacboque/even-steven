# Copy to .env (never commit .env). Sandbox only.
DEMO_MODE=mock            # mock = no keys needed; paypal = real PayPal sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
CURRENCY=EUR
# Sandbox personal account used by `npm run smoke:sandbox`
SMOKE_DEBTOR_EMAIL=

# Vision / agent LLM: google | openai | anthropic (set a spend cap on the key)
LLM_PROVIDER=google
LLM_MODEL=                 # empty = default (google: gemini-3.8-flash)
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
